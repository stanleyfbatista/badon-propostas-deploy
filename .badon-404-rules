# BEGIN BADON CUSTOM 404
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# Retired institutional home; keep query parameters and do not redirect app/forms.
RewriteCond %{HTTP_HOST} ^(?:www\.)?produtorabadon\.com(?::[0-9]+)?$ [NC]
RewriteRule ^home/?$ https://produtorabadon.com/ [R=301,END]
# Retired WordPress routes must never reach a front controller or return a soft 404.
RewriteRule ^(?:wp-admin|wp-content|wp-includes|wp-json)(?:/|$) - [R=404,END,NC]
RewriteRule ^(?:wp-[^/]+\.php|xmlrpc\.php|hello-world/?|comments/feed/?|cgi-sys/suspendedpage\.cgi)$ - [R=404,END,NC]
# Same public document root; app and legacy forms open Flow, not the institutional site.
RewriteCond %{HTTP_HOST} ^(?:app|forms)\.produtorabadon\.com(?::[0-9]+)?$ [NC]
RewriteRule ^$ admin/studio/index.php [END]
RewriteRule ^(?:entrar|painel)/?$ admin/studio/index.php [END]
RewriteRule ^f/[a-z0-9]+(?:-[a-z0-9]+)*/?$ f/index.php [END]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ - [R=404,L]
</IfModule>
# END BADON CUSTOM 404
